# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Publishing uses the existing Clerk-authenticated persistent Express backend.
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/youtube/callback
# At least 32 random bytes; use a different value from the encryption key.
OAUTH_STATE_SECRET=
# Exactly 32 random bytes encoded as base64. Keep stable across restarts/instances.
INTEGRATION_TOKEN_ENCRYPTION_KEY=
PUBLISH_WORKER_INTERVAL_MS=15000

B2_BUCKET_NAME=
B2_ENDPOINT=
B2_REGION=
B2_KEY_ID=
B2_APPLICATION_KEY=
